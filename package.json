{
  "name": "claude-code-usage",
  "displayName": "Claude Code Usage",
  "description": "Local Claude Code and Codex usage insights in the VS Code status bar",
  "version": "2.3.1",
  "publisher": "GrowthJack",
  "author": "GrowthJack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClaudeCodeUsage/ClaudeCodeUsage.git"
  },
  "bugs": {
    "url": "https://github.com/ClaudeCodeUsage/ClaudeCodeUsage/issues"
  },
  "homepage": "https://github.com/ClaudeCodeUsage/ClaudeCodeUsage",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "local-usage",
    "usage",
    "cost",
    "monitoring",
    "ai",
    "anthropic",
    "token",
    "status-bar"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Code Usage",
      "properties": {
        "claudeCodeUsage.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom Claude data directory path (leave empty for auto-detection)"
        },
        "claudeCodeUsage.codex.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom Codex data directory (leave empty for CODEX_HOME or ~/.codex)"
        },
        "claudeCodeUsage.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de-DE",
            "zh-TW",
            "zh-CN",
            "ja",
            "ko",
            "pt-BR",
            "id"
          ],
          "default": "auto",
          "description": "Display language (auto-detection or manual selection). All other settings now live in the dashboard's ⚙ Settings tab (Show Usage Details)."
        },
        "claudeCodeUsage.advice.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the 'Get AI Advice' feature (used when advice.backend = api). Leave empty to use the subscription backend. Other advice options live in the dashboard's ⚙ Settings tab."
        }
      }
    },
    "commands": [
      {
        "command": "claudeCodeUsage.refresh",
        "title": "Refresh Usage Data",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.showDetails",
        "title": "Show Usage Details",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.openSettings",
        "title": "Open Settings",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.refreshPricing",
        "title": "Refresh Token Pricing",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.getAdvice",
        "title": "Get AI Usage Advice",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.showLogs",
        "title": "Show Diagnostic Logs",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.exportHeatmap",
        "title": "Export Token Heatmap (GitHub style SVG)",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.exportShareCard",
        "title": "Export Usage Share Card (SVG)",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.publishHeatmapToGitHub",
        "title": "Publish Token Heatmap to GitHub",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeCodeUsage.previewWhatsNew",
        "title": "Preview What's New",
        "category": "Claude Code Usage"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:node",
    "test:node": "npm run compile && node --test out/test/*.test.js .github/scripts/*.test.mjs",
    "test:ui": "npm run compile && playwright test",
    "test:ui:update": "npm run compile && playwright test --update-snapshots",
    "test:release": "npm run test:node && npm run test:ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.0.15",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.8.3"
  }
}
