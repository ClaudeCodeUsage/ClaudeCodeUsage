{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": false,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
